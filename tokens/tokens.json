    "scrim-sheet": {
      "$type": "color",
      "$value": "rgba(17,17,17,0.28)",
      "$description": "Behind the phone print sheet (AppPrint)"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "monospace"
      ]
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      }
    },
    "tracking-heading": {
      "$type": "dimension",
      "$value": "-0.02em"
    },
    "tracking-code": {
      "$type": "dimension",
      "$value": "0.3em",
      "$description": "Login code field (Login, MLogin boards)"
    },
    "tracking-reader": {
      "$type": "dimension",
      "$value": "-0.01em",
      "$description": "Reader instruction (GuideReader)"
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-0.04em",
      "$description": "Timer digits, layer numbers (GuideReader, AppTimer, Guide05–07)"
    }
  },
