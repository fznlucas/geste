{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "paper": {
      "$type": "color",
      "$value": "#FAFAF8"
    },
    "ink": {
      "$type": "color",
      "$value": "#111111"
    },
    "stone": {
      "$type": "color",
      "$value": "#6F6A64"
    },
    "line": {
      "$type": "color",
      "$value": "#E4DFD8"
    },
    "mist": {
      "$type": "color",
      "$value": "#F1EEEA"
    },
    "sand": {
      "$type": "color",
      "$value": "#EDEAE5"
    },
    "signal": {
      "$type": "color",
      "$value": "#B3261E"
    }
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#FAFAF8",
      "$description": "Paper — page background"
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Inputs, admin cards"
    },
    "surface-muted": {
      "$type": "color",
      "$value": "#F1EEEA",
      "$description": "Mist — panels, tips, image grounds, ghost hover"
    },
    "surface-sunk": {
      "$type": "color",
      "$value": "#EDEAE5",
      "$description": "Sand — print mats, packaging"
    },
    "surface-hover": {
      "$type": "color",
      "$value": "#F4F1ED",
      "$description": "Table row hover, kanban column"
    },
    "fg": {
      "$type": "color",
      "$value": "#111111",
      "$description": "Ink — text, primary buttons"
    },
    "fg-muted": {
      "$type": "color",
      "$value": "#6F6A64",
      "$description": "Stone — secondary text, 5.1:1 on Paper, never on Sand"
    },
    "fg-inverse": {
      "$type": "color",
      "$value": "#FAFAF8",
      "$description": "Text on Ink"
    },
    "fg-muted-on-dark": {
      "$type": "color",
      "$value": "#A9A39C",
      "$description": "Stone equivalent on Ink"
    },
    "fg-muted-print": {
      "$type": "color",
      "$value": "#5E5953",
      "$description": "Stone on printed pages (Guide01–08): darker for toner"
    },
    "border": {
      "$type": "color",
      "$value": "#E4DFD8",
      "$description": "Line — dividers, empty progress"
    },
    "border-field": {
      "$type": "color",
      "$value": "#D8D3CC",
      "$description": "Input and pill borders"
    },
    "border-dashed": {
      "$type": "color",
      "$value": "#BDB6AD",
      "$description": "Upload zones, guides"
    },
    "action-hover": {
      "$type": "color",
      "$value": "#2E2B28",
      "$description": "Primary button hover"
    },
    "danger": {
      "$type": "color",
      "$value": "#B3261E",
      "$description": "Signal — errors, destructive, urgent; 6.3:1 on Paper"
    }
  },
  "overlay": {
    "scrim": {
      "$type": "color",
      "$value": "rgba(17,17,17,0.24)"
