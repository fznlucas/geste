{
  "name": "geste",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "test:unit": "vitest run && SIM_PERF=1 vitest run tests/unit/sim-perf.test.ts",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_test.sql",
    "screens": "playwright test --project=screens-1440 --project=screens-390",
    "screens:update": "playwright test --project=screens-1440 --project=screens-390 --update-snapshots"
  },
  "dependencies": {
    "@mux/mux-node": "^12.0.0",
    "@mux/mux-player-react": "^3.5.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.5.0",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/nextjs": "^10.10.0",
    "@serwist/next": "^9.2.0",
    "@stripe/react-stripe-js": "^4.0.0",
    "@stripe/stripe-js": "^7.9.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.0",
    "next": "16.3.6",
    "next-intl": "^4.3.0",
    "posthog-js": "^1.260.0",
    "posthog-node": "^5.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.0.0",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.6",
    "serwist": "^9.2.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
